class Solution {
public:
    int evalRPN(vector<string>& tokens) {
        stack<int> value;
        int result = 0;
        for (auto& token : tokens) {
            if (token != "+" && token != "-" && token != "*" && token != "/") {
                // It's a number
                int num = stoi(token);
                value.push(num);
            } else {
                // It's an operator
                int b = value.top();
                value.pop();
                int a = value.top();
                value.pop();

                int result;
                if (token == "+") {
                    result = a + b;
                } else if (token == "-") {
                    result = a - b;
                } else if (token == "*") {
                    result = a * b;
                } else if (token == "/") {
                    result = a / b;
                }

                value.push(result);
            }
        }
        return value.top();
    }
};
