/*
Koko Eating Bananas — Binary Search on the Answer

Instead of searching through the piles, we binary search on Koko’s eating speed k.

Key insight:
- If Koko can finish all bananas at speed k, she can also finish at any speed > k
- If she cannot finish at speed k, any speed < k will also fail
- This monotonic behavior allows binary search on k

For each candidate speed k, we compute the total hours needed by summing
the hours required for each pile using integer ceil division.

The goal is to find the minimum k such that total hours ≤ h.
*/

class Solution {
public:

    // Returns true if the total hours needed (hSum)
    // does not exceed the allowed hours h
    bool canFinish(int hSum, int h)
    {
        return hSum <= h;
    }

    int minEatingSpeed(vector<int>& piles, int h) {
        // Lowest possible eating speed
        int low = 1;

        // Highest necessary speed is the largest pile
        int high = *max_element(piles.begin(), piles.end());

        // Stores the smallest valid speed found
        int ans = 0;

        // Binary search over possible eating speeds
        while (low <= high)
        {
            // Candidate eating speed
            int proposedSpeed = (low + high) / 2;

            int sumOfHours = 0;

            // Compute total hours needed at this speed
            for (int p : piles)
            {
                // Integer ceil division:
                // If there is any remainder, it still costs a full hour
                sumOfHours += (p + proposedSpeed - 1) / proposedSpeed;

                // Early exit if already exceeding allowed hours
                if (sumOfHours > h)
                {
                    break;
                }
            }

            // If this speed works, try to find a smaller valid speed
            if (canFinish(sumOfHours, h))
            {
                ans = proposedSpeed;
                high = proposedSpeed - 1;
            }
            // Otherwise, speed is too slow — increase it
            else
            {
                low = proposedSpeed + 1;
            }
        }

        // Minimum eating speed that allows finishing within h hours
        return ans;
    }
};
