#Two pointer solution; To solve this problem draw a timeline interval and place the allotted times on a dotted line. This way you can visualize the solution
class Solution:
    def minMeetingRooms(self, intervals: List[Interval]) -> int:
        start = []
        end = []
        for k in intervals:
            start.append(k.start)
            end.append(k.end)
        start.sort()
        end.sort()
        answer = count = 0

        s = e = 0


        while s < len(intervals):
            if start[s] < end[e]:
                count += 1
                s += 1
            else:
                e += 1
                count -= 1
            answer = max (count , answer)
        return answer
